{
  "name": "smspit",
  "version": "1.0.0",
  "description": "Mock Twilio SMS server with web UI for developers",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @smspit/server dev",
    "dev:web": "pnpm --filter @smspit/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @smspit/server start"
  }
}