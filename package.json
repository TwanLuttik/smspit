{
  "name": "smspit",
  "version": "1.1.0",
  "description": "Mock Twilio SMS server with web UI for developers",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "bun run --workspaces --parallel dev",
    "dev:server": "bun run --filter @smspit/server dev",
    "dev:web": "bun run --filter @smspit/web dev",
    "build": "bun run --workspaces build",
    "start": "bun run --filter @smspit/server start"
  }
}
