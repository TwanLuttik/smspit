FROM node:22-alpine AS base
WORKDIR /app

FROM base AS deps
WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci

FROM base AS builder
WORKDIR /app/web
COPY --from=deps /app/web/node_modules ./node_modules
COPY web/src ./src
COPY web/index.html ./
COPY web/vite.config.ts ./
COPY web/tsconfig*.json ./
RUN npm run build

FROM base AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV WEB_PORT=4011
ENV API_URL=http://localhost:4010

RUN addgroup -g 1001 -S smspit && adduser -S smspit -u 1001

COPY --from=builder /app/web/dist ./dist

RUN mkdir -p /app/data && chown -R smspit:smspit /app

USER smspit

EXPOSE 4011

CMD ["sh", "-c", "npx http-server . -p $WEB_PORT -c-1 --cors"]