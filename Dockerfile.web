FROM node:22-alpine AS base
WORKDIR /app

FROM base AS deps
WORKDIR /app
COPY package*.json ./
COPY web/package*.json ./web/
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build --workspace=web

FROM base AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV WEB_PORT=4011
ENV API_URL=http://localhost:4010

RUN addgroup -g 1001 -S smspit && adduser -S smspit -u 1001

COPY --from=builder /app/web/dist ./dist

RUN mkdir -p /app/data && chown -R smspit:smspit /app

USER smspit

EXPOSE 4011

CMD ["sh", "-c", "npx http-server ./dist -p $WEB_PORT -c-1 --cors"]