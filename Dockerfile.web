FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11 --activate
WORKDIR /app

FROM base AS deps
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY web/package.json ./web/
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY web ./web
RUN pnpm --filter @smspit/web build

FROM base AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV WEB_PORT=4011
ENV API_URL=http://localhost:4010

RUN addgroup -g 1001 -S smspit && adduser -S smspit -u 1001

COPY --from=builder /app/web/dist ./dist

RUN mkdir -p /app/data && chown -R smspit:smspit /app

USER smspit

EXPOSE 4011

CMD ["sh", "-c", "npx http-server ./dist -p $WEB_PORT -c-1 --cors"]